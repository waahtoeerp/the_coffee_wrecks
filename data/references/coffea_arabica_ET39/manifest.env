# Reference: Coffea arabica cv. ET-39 HiFi (RefSeq assembly GCF_036785885.1, BioProject PRJNA698600)
# Read by fetch.sh and pipeline/check.sh. Edit here, nowhere else.

REF_NAME=coffea_arabica_ET39
ASSEMBLY=GCF_036785885.1_Coffea_Arabica_ET-39_HiFi
SOURCE_DIR=https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/036/785/885/GCF_036785885.1_Coffea_Arabica_ET-39_HiFi

# Output file, relative to the reference folder's parent (ref_gen/)
OUTPUT_FILE=${ASSEMBLY}_genomic.fna

# Checksums. The .gz value is NCBI's published md5 (md5checksums.txt in SOURCE_DIR).
# The .fna value is the decompressed file, checked against the same NCBI download
# in the 2026-08-22 setup (see PIPELINE.md).
EXPECTED_MD5_GZ=6bc818991d1ed9e32e9e8ff99119c4c0
EXPECTED_MD5_FNA=ecfeb1a94a681d021944f88bbb6bd862
